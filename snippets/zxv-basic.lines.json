{
  "//": "Snippets del BASIC de la ROM SIN números de línea: los pone la extensión (src/snippets.ts) siguiendo los de alrededor.",
  "FOR ... NEXT": {
    "prefix": "for",
    "body": ["FOR ${1:i}=${2:1} TO ${3:10}", "$0", "NEXT ${1:i}"],
    "description": "Un bucle FOR"
  },
  "WHILE ... WEND": {
    "prefix": "while",
    "body": ["WHILE ${1:condición}", "$0", "WEND"],
    "description": "Repite mientras se cumpla"
  },
  "REPEAT ... UNTIL": {
    "prefix": "repeat",
    "body": ["REPEAT", "$0", "UNTIL ${1:condición}"],
    "description": "Repite hasta que se cumpla"
  },
  "IF ... END IF": {
    "prefix": "if",
    "body": ["IF ${1:condición} THEN", "$0", "END IF"],
    "description": "El IF de bloque"
  },
  "IF ... ELSE ... END IF": {
    "prefix": "ifelse",
    "body": ["IF ${1:condición} THEN", "$2", "ELSE", "$0", "END IF"],
    "description": "El IF de bloque con ELSE"
  },
  "SELECT CASE": {
    "prefix": "select",
    "body": ["SELECT CASE ${1:valor}", "CASE ${2:1}", "$3", "CASE ELSE", "$0", "END SELECT"],
    "description": "Elige según un valor"
  },
  "DEF PROC": {
    "prefix": "defproc",
    "body": ["DEF PROC ${1:nombre}(${2:a})", "$0", "END PROC"],
    "description": "Un procedimiento"
  },
  "ON ERROR": {
    "prefix": "onerror",
    "body": ["ON ERROR GO TO @${1:fallo}", "$0", "STOP", "@${1:fallo}: PRINT \"Error \"; ERR; \" en la linea \"; ERL"],
    "description": "Atrapa los errores"
  },
  "Bucle de juego": {
    "prefix": "gameloop",
    "body": [
      "MODE 0: LET p=0",
      "REPEAT",
      "SCREEN 1-p: CLS",
      "$0",
      "PAGE 1-p: LET p=1-p: WAIT 1",
      "UNTIL INKEY$=\" \""
    ],
    "description": "Doble buffer a 60 imágenes por segundo"
  },
  "REM": {
    "prefix": "rem",
    "body": ["REM ${0:comentario}"],
    "description": "Un comentario"
  }
}
